bottom":"7","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"heading","editSettings":{"defaultEditRoute":"content"}},{"id":"2385673e","elType":"widget","isInner":false,"isLocked":false,"settings":{"editor":"<p style=\"text-align: center;\">Psic\u00f3logas, terapeutas y especialistas en adicciones con formaci\u00f3n acreditada y experiencia real.<\/p><p style=\"text-align: center;\">En Emerae trabajamos en grupos peque\u00f1os y con atenci\u00f3n individualizada. Las mismas personas te acompa\u00f1an desde el primer d\u00eda hasta el \u00faltimo.<\/p>","typography_typography":"custom","typography_font_family":"Inter","typography_font_size":{"size":0.94999999999999996,"unit":"rem"},"typography_font_weight":"300","typography_line_height":{"size":1.75,"unit":"em"},"text_color":"#4a5a6a","_margin":{"unit":"px","top":"0","right":"60","bottom":"35","left":"60","isLinked":false},"max_width":{"size":580,"unit":"px"}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"text-editor","editSettings":{"defaultEditRoute":"content"}},{"id":"3fb94661","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<style>\r\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Inter:wght@300;400;500;600&display=swap');\r\n*{box-sizing:border-box;margin:0;padding:0;}\r\n.eq-carousel-wrap{overflow:hidden;font-family:'Inter',sans-serif;}\r\n.eq-cards-track{display:flex;gap:20px;transition:transform 0.6s cubic-bezier(0.4,0,0.2,1);}\r\n.eq-card{flex:0 0 calc(25% - 15px);background:#f7f8f9;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;}\r\n.eq-card-img{width:100%;aspect-ratio:3\/2.5;;background:linear-gradient(160deg,#BDDAE8 0%,#e8f3f8 60%,#f0f8fb 100%);display:flex;align-items:flex-end;justify-content:center;overflow:hidden;}\r\n.eq-silhouette{width:68%;height:82%;background:rgba(4,92,180,0.13);border-radius:50% 50% 0 0 \/ 55% 55% 0 0;position:relative;flex-shrink:0;}\r\n.eq-silhouette::before{content:'';position:absolute;top:-26px;left:50%;transform:translateX(-50%);width:42px;height:42px;background:rgba(4,92,180,0.16);border-radius:50%;}\r\n.eq-card-body{padding:18px 20px 22px;}\r\n.eq-card-name{font-size:0.9rem;font-weight:600;color:#031830;letter-spacing:-0.01em;margin-bottom:3px;}\r\n.eq-card-role{font-size:0.76rem;color:#045CB4;font-weight:400;margin-bottom:10px;}\r\n.eq-card-bio{font-size:0.76rem;color:#7a8a9a;line-height:1.6;font-weight:300;}\r\n.eq-nav{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:36px;}\r\n.eq-arrow{width:40px;height:40px;border-radius:50%;border:1px solid rgba(3,24,48,0.15);background:white;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;color:#031830;transition:all 0.2s;font-family:sans-serif;}\r\n.eq-arrow:hover{background:#031830;color:white;border-color:#031830;}\r\n.eq-dots{display:flex;gap:6px;align-items:center;}\r\n.eq-dot{width:6px;height:6px;border-radius:50%;background:rgba(3,24,48,0.15);cursor:pointer;transition:all 0.25s;}\r\n.eq-dot.active{background:#045CB4;width:20px;border-radius:4px;}\r\n<\/style>\r\n\r\n<div class=\"eq-carousel-wrap\">\r\n  <div class=\"eq-cards-track\" id=\"eq-track\">\r\n    <div class=\"eq-card\">\r\n      <div class=\"eq-card-img\"><div class=\"eq-silhouette\"><\/div><\/div>\r\n      <div class=\"eq-card-body\">\r\n        <p class=\"eq-card-name\">Paula Ferrer<\/p>\r\n        <p class=\"eq-card-role\">Directora \u00b7 Psic\u00f3loga cl\u00ednica<\/p>\r\n        <p class=\"eq-card-bio\">M\u00e1s de 20 a\u00f1os acompa\u00f1ando a personas y familias en procesos de recuperaci\u00f3n.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"eq-card\">\r\n      <div class=\"eq-card-img\"><div class=\"eq-silhouette\"><\/div><\/div>\r\n      <div class=\"eq-card-body\">\r\n        <p class=\"eq-card-name\">Nombre Apellido<\/p>\r\n        <p class=\"eq-card-role\">Psicoterapeuta \u00b7 TCC<\/p>\r\n        <p class=\"eq-card-bio\">Especializada en terapia cognitivo-conductual de tercera generaci\u00f3n y regulaci\u00f3n emocional.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"eq-card\">\r\n      <div class=\"eq-card-img\"><div class=\"eq-silhouette\"><\/div><\/div>\r\n      <div class=\"eq-card-body\">\r\n        <p class=\"eq-card-name\">Nombre Apellido<\/p>\r\n        <p class=\"eq-card-role\">Terapeuta \u00b7 EMDR<\/p>\r\n        <p class=\"eq-card-bio\">Formaci\u00f3n acreditada en EMDR y trauma. Trabaja el origen emocional de la dependencia.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"eq-card\">\r\n      <div class=\"eq-card-img\"><div class=\"eq-silhouette\"><\/div><\/div>\r\n      <div class=\"eq-card-body\">\r\n        <p class=\"eq-card-name\">Nombre Apellido<\/p>\r\n        <p class=\"eq-card-role\">Patolog\u00eda dual<\/p>\r\n        <p class=\"eq-card-bio\">Experiencia en el abordaje simult\u00e1neo de adicci\u00f3n y trastornos del estado de \u00e1nimo.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"eq-card\">\r\n      <div class=\"eq-card-img\"><div class=\"eq-silhouette\"><\/div><\/div>\r\n      <div class=\"eq-card-body\">\r\n        <p class=\"eq-card-name\">Nombre Apellido<\/p>\r\n        <p class=\"eq-card-role\">Terapeuta familiar<\/p>\r\n        <p class=\"eq-card-bio\">Acompa\u00f1a a familias para entender y sostener el proceso desde el entorno cercano.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"eq-card\">\r\n      <div class=\"eq-card-img\"><div class=\"eq-silhouette\"><\/div><\/div>\r\n      <div class=\"eq-card-body\">\r\n        <p class=\"eq-card-name\">Nombre Apellido<\/p>\r\n        <p class=\"eq-card-role\">Psic\u00f3loga cl\u00ednica<\/p>\r\n        <p class=\"eq-card-bio\">Especializada en adicciones comportamentales y acompa\u00f1amiento en procesos de reca\u00edda.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/div>\r\n\r\n<div class=\"eq-nav\">\r\n  <button class=\"eq-arrow\" onclick=\"eqPrev()\">&#8592;<\/button>\r\n  <div class=\"eq-dots\" id=\"eq-dots\">\r\n    <div class=\"eq-dot active\" onclick=\"eqGoTo(0)\"><\/div>\r\n    <div class=\"eq-dot\" onclick=\"eqGoTo(1)\"><\/div>\r\n    <div class=\"eq-dot\" onclick=\"eqGoTo(2)\"><\/div>\r\n  <\/div>\r\n  <button class=\"eq-arrow\" onclick=\"eqNext()\">&#8594;<\/button>\r\n<\/div>\r\n\r\n<script>\r\nvar eqCurrent=0,eqPages=3;\r\nvar eqTrack=document.getElementById('eq-track');\r\nvar eqDots=document.querySelectorAll('.eq-dot');\r\nfunction eqUpdate(){\r\n  var cardW=eqTrack.children[0].offsetWidth+20;\r\n  eqTrack.style.transform='translateX(-'+(eqCurrent*cardW)+'px)';\r\n  eqDots.forEach(function(d,i){d.classList.toggle('active',i===eqCurrent);});\r\n}\r\nfunction eqNext(){eqCurrent=(eqCurrent+1)%eqPages;eqUpdate();}\r\nfunction eqPrev(){eqCurrent=(eqCurrent-1+eqPages)%eqPages;eqUpdate();}\r\nfunction eqGoTo(i){eqCurrent=i;eqUpdate();}\r\n<\/script>","_margin":{"unit":"px","top":"-15","right":"-15","bottom":"-15","left":"-15","isLinked":true}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}},{"id":"950124d","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<div style=\"margin-top:40px;text-align:center;padding-top:24px;border-top:1px solid rgba(3,24,48,0.08);\">\r\n  <p style=\"font-family:'Instrument Serif',serif;font-style:italic;font-size:1.45rem;color:#031830;line-height:1.5;font-weight:400;max-width:640px;margin:0 auto;\">\u201cPorque la recuperaci\u00f3n merece rigor. Y el rigor empieza por saber <span style=\"color:#045CB4;\">en manos de qui\u00e9n est\u00e1s.<\/span>\u201d<\/p>\r\n<\/div>","_margin":{"unit":"px","top":"8","right":"8","bottom":"8","left":"8","isLinked":true}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout","panel":{"activeTab":"layout","activeSection":"section_layout_container"}}}],"page_settings":{"template":"default"},"version":"0.4","title":"8.EQUIPO_EMERAE","type":"container"}