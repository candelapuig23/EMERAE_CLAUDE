{"content":[{"id":"520b0ebf","elType":"section","isInner":false,"isLocked":false,"settings":{"layout":"full_width","background_background":"classic","background_color":"#ffffff","padding":{"unit":"px","top":"120","right":"80","bottom":"120","left":"80","isLinked":false},"_title":"ADICCIONES"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"f6a5b0c","elType":"column","isInner":false,"isLocked":false,"settings":{"_column_size":100},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"40ea04f2","elType":"section","isInner":true,"isLocked":false,"settings":{"layout":"full_width","gap":"custom","gap_columns_custom":{"unit":"px","size":80},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"72df742c","elType":"column","isInner":false,"isLocked":false,"settings":{"_column_size":35,"content_position":"top","_inline_size":54.228999999999999},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"27ab33f7","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<div style=\"margin-bottom:20px;\"><span style=\"display:inline-flex;align-items:center;gap:8px;background:rgba(4,92,180,0.06);border:1px solid rgba(4,92,180,0.15);border-radius:100px;padding:5px 14px 5px 10px;font-family:Inter,sans-serif;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(4,92,180,0.75);\"><span style=\"width:5px;height:5px;border-radius:50%;background:#045CB4;display:inline-block;\"><\/span>Qu\u00e9 tratamos<\/span><\/div>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}},{"id":"326ac32f","elType":"widget","isInner":false,"isLocked":false,"settings":{"title":"\u00bfQu\u00e9 est\u00e1s intentando dejar de sostener?","typography_typography":"custom","typography_font_family":"Instrument Serif","typography_font_size":{"unit":"rem","size":2.3999999999999999},"typography_font_weight":"400","typography_line_height":{"unit":"em","size":1.2},"title_color":"#031830","_margin":{"unit":"px","top":"0","right":"0","bottom":"20","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"heading","editSettings":{"defaultEditRoute":"content"}},{"id":"2843aa66","elType":"widget","isInner":false,"isLocked":false,"settings":{"editor":"<p style=\"font-family: Inter,sans-serif; font-size: 1rem; line-height: 1.75; color: #4a5a6a; margin-bottom: 16px;\">La adicci\u00f3n puede manifestarse de formas muy distintas, con sustancias o sin ellas. En todos los casos genera un patr\u00f3n de dependencia que afecta a la persona en m\u00faltiples niveles: emocional, relacional, laboral y f\u00edsico.<\/p><p style=\"font-family: Inter,sans-serif; font-size: 1rem; line-height: 1.75; color: #4a5a6a;\">Tratamos ambos tipos con el mismo rigor y la misma profundidad terap\u00e9utica.<\/p>","_margin":{"unit":"px","top":"0","right":"0","bottom":"40","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"text-editor","editSettings":{"defaultEditRoute":"content"}},{"id":"e8f7eca","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<div style=\"display:flex;flex-direction:column;gap:8px;\">\r\n\r\n  <button onclick=\"showTab('sustancias')\" id=\"tab-sustancias\" style=\"text-align:left;padding:14px 20px;border-radius:12px;border:1.5px solid #045CB4;background:#045CB4;color:#fff;font-family:Inter,sans-serif;font-size:0.88rem;font-weight:500;cursor:pointer;transition:all 0.2s;\">\r\n    Adicci\u00f3n a sustancias\r\n  <\/button>\r\n  <div id=\"desc-sustancias\" style=\"display:block;padding:4px 4px 12px 4px;\">\r\n    <p style=\"font-family:Inter,sans-serif;font-size:0.82rem;color:#7a8a9a;line-height:1.65;margin:0;\">\r\n      Cada sustancia cumple un una funci\u00f3n distinta en la vida de la persona. Comprenderla es el primer paso para poder dejar de necesitarla.\r\n    <\/p>\r\n  <\/div>\r\n\r\n  <button onclick=\"showTab('comportamentales')\" id=\"tab-comportamentales\" style=\"text-align:left;padding:14px 20px;border-radius:12px;border:1.5px solid rgba(7,33,61,0.1);background:#f7f8f9;color:#4a5a6a;font-family:Inter,sans-serif;font-size:0.88rem;font-weight:500;cursor:pointer;transition:all 0.2s;\">\r\n    Adicciones comportamentales\r\n  <\/button>\r\n  <div id=\"desc-comportamentales\" style=\"display:none;padding:4px 4px 12px 4px;\">\r\n    <p style=\"font-family:Inter,sans-serif;font-size:0.82rem;color:#7a8a9a;line-height:1.65;margin:0;\">\r\n      Son igual de reales que las de sustancias. Al no haber una sustancia visible, suelen normalizarse durante m\u00e1s tiempo \u2014 y el da\u00f1o va creciendo en silencio. En Emerae las abordamos con la misma profundidad terap\u00e9utica.\r\n    <\/p>\r\n  <\/div>\r\n\r\n  <button onclick=\"showTab('dual')\" id=\"tab-dual\" style=\"text-align:left;padding:14px 20px;border-radius:12px;border:1.5px solid rgba(7,33,61,0.1);background:#f7f8f9;color:#4a5a6a;font-family:Inter,sans-serif;font-size:0.88rem;font-weight:500;cursor:pointer;transition:all 0.2s;\">\r\n    Patolog\u00eda dual\r\n  <\/button>\r\n  <div id=\"desc-dual\" style=\"display:none;padding:4px 4px 12px 4px;\">\r\n    <p style=\"font-family:Inter,sans-serif;font-size:0.82rem;color:#7a8a9a;line-height:1.65;margin:0;\">\r\n      En muchas ocasiones, la adicci\u00f3n es solo una parte de la historia. Tambi\u00e9n es necesario atender el malestar que hay detr\u00e1s.\r\n    <\/p>\r\n  <\/div>\r\n\r\n<\/div>\r\n\r\n<script>\r\nfunction showTab(tab) {\r\n  ['sustancias','comportamentales','dual'].forEach(t => {\r\n    var btn = document.getElementById('tab-' + t);\r\n    var panel = document.getElementById('panel-' + t);\r\n    var desc = document.getElementById('desc-' + t);\r\n\r\n    if (t === tab) {\r\n      btn.style.background = '#045CB4';\r\n      btn.style.color = '#fff';\r\n      btn.style.borderColor = '#045CB4';\r\n\r\n      if (panel) panel.style.display = 'grid';\r\n      if (desc) desc.style.display = 'block';\r\n\r\n    } else {\r\n      btn.style.background = '#f7f8f9';\r\n      btn.style.color = '#4a5a6a';\r\n      btn.style.borderColor = 'rgba(7,33,61,0.1)';\r\n\r\n      if (panel) panel.style.display = 'none';\r\n      if (desc) desc.style.display = 'none';\r\n    }\r\n  });\r\n}\r\n<\/script>","_element_width":"initial","_element_custom_width":{"unit":"%","size":93.995000000000005},"_flex_size":"none"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}},{"id":"3d9e4626","elType":"column","isInner":false,"isLocked":false,"settings":{"_column_size":65,"content_position":"top","_inline_size":45.771000000000001},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"2363b278","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<style>\r\n.adic-card{background:#f7f8f9;border:1px solid rgba(7,33,61,0.06);border-radius:16px;padding:24px 20px;display:flex;flex-direction:column;gap:12px;text-decoration:none;transition:all 0.2s;cursor:pointer;}\r\n.adic-card:hover{background:#EEF5FB;border-color:rgba(4,92,180,0.2);transform:translateY(-2px);}\r\n.adic-card__icon{\r\n  width:40px;\r\n  height:40px;\r\n  border-radius:10px;\r\n  background:#BDDAE8;\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  font-size:1rem;\r\n  font-weight:600;\r\n  color:#031830 !important;\r\n}\r\n.adic-card__title{font-family:Inter,sans-serif;font-size:0.95rem;font-weight:600;color:#031830;display:flex;justify-content:space-between;align-items:center;}\r\n.adic-card__title span{font-size:0.8rem;color:#045CB4;}\r\n.adic-card__desc{font-family:Inter,sans-serif;font-size:0.8rem;color:#7a8a9a;line-height:1.5;}\r\n.adic-dual-card{background:#031830;border-radius:16px;padding:32px;}\r\n.adic-dual-card h3{font-family:'Instrument Serif',serif;font-size:1.4rem;color:#fff;margin-bottom:12px;}\r\n.adic-dual-card p{font-family:Inter,sans-serif;font-size:0.88rem;color:rgba(255,255,255,0.55);line-height:1.75;margin-bottom:20px;}\r\n.adic-dual-card a{display:inline-flex;align-items:center;gap:8px;font-family:Inter,sans-serif;font-size:0.82rem;color:#BDDAE8;text-decoration:none;}\r\n<\/style>\r\n\r\n<div id=\"panel-sustancias\" style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:12px;\">\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">01<\/div><div class=\"adic-card__title\">Alcohol <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Una de las dependencias m\u00e1s normalizadas y m\u00e1s dif\u00edciles de reconocer.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">02<\/div><div class=\"adic-card__title\">Coca\u00edna <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Pat\u00f3n de consumo intenso con alto impacto emocional y relacional.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">03<\/div><div class=\"adic-card__title\">Cannabis <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Frecuentemente infravalorado. La dependencia puede ser igual de profunda.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">04<\/div><div class=\"adic-card__title\">Opioides <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Requiere acompa\u00f1amiento cl\u00ednico especializado desde el primer d\u00eda.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">05<\/div><div class=\"adic-card__title\">MDMA <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Impacto severo en la regulaci\u00f3n emocional y el sistema nervioso.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">06<\/div><div class=\"adic-card__title\">Chemsex <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Tratamiento con plena confidencialidad y sin ning\u00fan tipo de juicio.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">07<\/div><div class=\"adic-card__title\">Tabaco <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Dependencia f\u00edsica y emocional que merece un abordaje serio.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">08<\/div><div class=\"adic-card__title\">Otras drogas <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Si no encuentras lo que buscas, contacta con nosotros.<\/div><\/a>\r\n<\/div>\r\n\r\n<div id=\"panel-comportamentales\" style=\"display:none;grid-template-columns:repeat(2,1fr);gap:12px;\">\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">01<\/div><div class=\"adic-card__title\">Juego <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Una adicci\u00f3n que crece en silencio y afecta a toda la familia.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">02<\/div><div class=\"adic-card__title\">Pornograf\u00eda <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Impacto real en la intimidad, las relaciones y la autoestima.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">03<\/div><div class=\"adic-card__title\">Internet <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">El uso compulsivo digital puede generar una dependencia igual de real.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">04<\/div><div class=\"adic-card__title\">Videojuegos <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Especialmente frecuente en j\u00f3venes. Tratamiento adaptado.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">05<\/div><div class=\"adic-card__title\">Compras <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Patr\u00f3n compulsivo que oculta un malestar emocional profundo.<\/div><\/a>\r\n  <a href=\"#\" class=\"adic-card\"><div class=\"adic-card__icon\">06<\/div><div class=\"adic-card__title\">Comida <span>\u2192<\/span><\/div><div class=\"adic-card__desc\">Abordaje desde el origen emocional, sin juicios ni protocolos r\u00edgidos.<\/div><\/a>\r\n<\/div>\r\n\r\n<div id=\"panel-dual\" style=\"display:none;grid-template-columns:1fr;gap:12px;margin-top:48px;\">\r\n  <div class=\"adic-dual-card\">\r\n    <h3>Patolog\u00eda dual<\/h3>\r\n    <p>Es m\u00e1s frecuente de lo que se cree: la mayor\u00eda de personas con una adicci\u00f3n presentan tambi\u00e9n alg\u00fan trastorno mental asociado. Ansiedad, depresi\u00f3n, trauma, TDAH.<\/p>\r\n    <p>Tratar solo la adicci\u00f3n sin atender lo que hay detr\u00e1s multiplica el riesgo de reca\u00edda. En Emerae contamos con experiencia espec\u00edfica en el diagn\u00f3stico y tratamiento de la patolog\u00eda dual.<\/p>\r\n    <a href=\"#\">Saber m\u00e1s sobre patolog\u00eda dual \u2192<\/a>\r\n  <\/div>\r\n<\/div>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout","panel":{"activeTab":"layout","activeSection":"section_layout"}}}],"page_settings":{"template":"default"},"version":"0.4","title":"6.ADICCIONES_EMERAE","type":"section"}