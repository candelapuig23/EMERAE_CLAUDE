{"content":[{"id":"4ea25265","elType":"container","isInner":false,"isLocked":false,"settings":{"content_width":"full","padding":{"unit":"px","top":"96","right":"48","bottom":"96","left":"48","isLinked":false},"background_color":"#ffffff","_title":"TESTIMONIOS"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"32782c00","elType":"container","isInner":true,"isLocked":false,"settings":{"max_width":{"size":1100,"unit":"px"},"flex_direction":"column","flex_align_items":"center","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"6236a4b","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<div style=\"text-align:center;margin-bottom:28px;\"><span style=\"display:inline-flex;align-items:center;gap:8px;background:rgba(4,92,180,0.06);border:1px solid rgba(4,92,180,0.15);border-radius:100px;padding:5px 14px 5px 10px;font-family:Inter,sans-serif;font-size:0.72rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(4,92,180,0.75);\"><span style=\"width:5px;height:5px;border-radius:50%;background:#045CB4;display:inline-block;flex-shrink:0;\"><\/span>Testimonios<\/span><\/div>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}},{"id":"288922d9","elType":"widget","isInner":false,"isLocked":false,"settings":{"title":"Lo que dicen quienes han pasado por Emerae","align":"center","typography_typography":"custom","typography_font_family":"Instrument Serif","typography_font_size":{"size":2.7999999999999998,"unit":"rem"},"typography_font_weight":"400","typography_font_style":"italic","typography_line_height":{"size":1.1499999999999999,"unit":"em"},"title_color":"#031830","_margin":{"unit":"px","top":"0","right":"0","bottom":"56","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"heading","editSettings":{"defaultEditRoute":"content"}},{"id":"599f4181","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap');\n*{box-sizing:border-box;margin:0;padding:0;}\n.tm-wrap{overflow:hidden;font-family:'Inter',sans-serif;}\n.tm-track{display:flex;gap:20px;transition:transform 0.6s cubic-bezier(0.4,0,0.2,1);}\n.tm-card{flex:0 0 calc(33.333% - 14px);background:#ffffff;border-radius:16px;padding:36px 32px;display:flex;flex-direction:column;gap:20px;box-shadow:0 2px 24px rgba(3,24,48,0.07),0 0 0 1px rgba(3,24,48,0.04);}\n.tm-card.dark{background:#031830;}\n.tm-quote-icon{font-family:'Instrument Serif',serif;font-size:3rem;color:#BDDAE8;line-height:1;font-style:italic;margin-bottom:-8px;}\n.tm-card.dark .tm-quote-icon{color:rgba(189,218,232,0.3);}\n.tm-text{font-family:'Instrument Serif',serif;font-style:italic;font-size:1rem;color:#031830;line-height:1.65;font-weight:400;flex:1;}\n.tm-card.dark .tm-text{color:#ffffff;}\n.tm-author{font-family:'Inter',sans-serif;font-size:0.78rem;color:#7a8a9a;font-weight:400;}\n.tm-card.dark .tm-author{color:rgba(189,218,232,0.5);}\n.tm-nav{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:36px;}\n.tm-arrow{width:40px;height:40px;border-radius:50%;border:1px solid rgba(3,24,48,0.15);background:white;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;color:#031830;transition:all 0.2s;font-family:sans-serif;}\n.tm-arrow:hover{background:#031830;color:white;border-color:#031830;}\n.tm-dots{display:flex;gap:6px;align-items:center;}\n.tm-dot{width:6px;height:6px;border-radius:50%;background:rgba(3,24,48,0.15);cursor:pointer;transition:all 0.25s;}\n.tm-dot.active{background:#045CB4;width:20px;border-radius:4px;}\n<\/style>\n\n<div class=\"tm-wrap\">\n  <div class=\"tm-track\" id=\"tm-track\">\n\n    <div class=\"tm-card\">\n      <div class=\"tm-quote-icon\">\"<\/div>\n      <p class=\"tm-text\">Llegu\u00e9 sin esperanza y sin saber muy bien qu\u00e9 esperar. Lo que encontr\u00e9 fue un equipo que me escuch\u00f3 de verdad, sin juzgarme. Hoy llevo dos a\u00f1os sin consumir.<\/p>\n      <p class=\"tm-author\">Paciente, 38 a\u00f1os<\/p>\n    <\/div>\n\n    <div class=\"tm-card dark\">\n      <div class=\"tm-quote-icon\">\"<\/div>\n      <p class=\"tm-text\">Como familiar, estaba completamente perdida. No sab\u00eda c\u00f3mo ayudar sin empeorar las cosas. En Emerae me dieron las herramientas que necesitaba.<\/p>\n      <p class=\"tm-author\">Familiar de paciente<\/p>\n    <\/div>\n\n    <div class=\"tm-card\">\n      <div class=\"tm-quote-icon\">\"<\/div>\n      <p class=\"tm-text\">Lo que m\u00e1s me sorprendi\u00f3 fue que no me trataron como un caso, sino como una persona. Eso lo cambia todo.<\/p>\n      <p class=\"tm-author\">Paciente, 45 a\u00f1os<\/p>\n    <\/div>\n\n    <div class=\"tm-card\">\n      <div class=\"tm-quote-icon\">\"<\/div>\n      <p class=\"tm-text\">Testimonio placeholder \u2014 reemplazar con testimonio real de Paula.<\/p>\n      <p class=\"tm-author\">Paciente<\/p>\n    <\/div>\n\n    <div class=\"tm-card dark\">\n      <div class=\"tm-quote-icon\">\"<\/div>\n      <p class=\"tm-text\">Testimonio placeholder \u2014 reemplazar con testimonio real de Paula.<\/p>\n      <p class=\"tm-author\">Familiar de paciente<\/p>\n    <\/div>\n\n  <\/div>\n<\/div>\n\n<div class=\"tm-nav\">\n  <button class=\"tm-arrow\" onclick=\"tmPrev()\">&#8592;<\/button>\n  <div class=\"tm-dots\" id=\"tm-dots\">\n    <div class=\"tm-dot active\" onclick=\"tmGoTo(0)\"><\/div>\n    <div class=\"tm-dot\" onclick=\"tmGoTo(1)\"><\/div>\n    <div class=\"tm-dot\" onclick=\"tmGoTo(2)\"><\/div>\n  <\/div>\n  <button class=\"tm-arrow\" onclick=\"tmNext()\">&#8594;<\/button>\n<\/div>\n\n<script>\nvar tmCurrent=0,tmPages=3;\nvar tmTrack=document.getElementById('tm-track');\nvar tmDots=document.querySelectorAll('.tm-dot');\nfunction tmUpdate(){\n  var cardW=tmTrack.children[0].offsetWidth+20;\n  tmTrack.style.transform='translateX(-'+(tmCurrent*cardW)+'px)';\n  tmDots.forEach(function(d,i){d.classList.toggle('active',i===tmCurrent);});\n}\nfunction tmNext(){tmCurrent=(tmCurrent+1)%tmPages;tmUpdate();}\nfunction tmPrev(){tmCurrent=(tmCurrent-1+tmPages)%tmPages;tmUpdate();}\nfunction tmGoTo(i){tmCurrent=i;tmUpdate();}\n<\/script>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout","panel":{"activeTab":"layout","activeSection":"section_layout_container"}}}],"page_settings":{"template":"default"},"version":"0.4","title":"10.TESTIMONIOS_EMERAE","type":"container"}