{"content":[{"id":"7dcdbd4a","elType":"container","isInner":false,"isLocked":false,"settings":{"content_width":"full","flex_direction":"column","flex_align_items":"center","flex_justify_content":"center","min_height":{"unit":"vh","size":95},"padding":{"unit":"px","top":"120","right":"160","bottom":"80","left":"160","isLinked":false},"background_background":"classic","background_color":"#f0f6fa","text_align":"center","_title":"hero"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"5d1cbc59","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<div style=\"text-align:center;margin-bottom:32px;\"><span style=\"display:inline-flex;align-items:center;gap:8px;background:rgba(4,92,180,0.08);border:1px solid rgba(4,92,180,0.2);border-radius:100px;padding:6px 16px 6px 10px;font-family:Inter,sans-serif;font-size:0.72rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(4,92,180,0.85);\"><span style=\"width:6px;height:6px;border-radius:50%;background:#045CB4;display:inline-block;\"><\/span>Centro especializado en  adicciones &middot; Barcelona<\/span><\/div>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}},{"id":"4ebcc63d","elType":"widget","isInner":false,"isLocked":false,"settings":{"title":"Recuperarse no es solo dejar de consumir.","header_size":"h1","align":"center","typography_typography":"custom","typography_font_family":"Instrument Serif","typography_font_size":{"unit":"vw","size":5.2000000000000002},"typography_font_style":"italic","typography_font_weight":"400","typography_line_height":{"unit":"em","size":1.0800000000000001},"typography_letter_spacing":{"unit":"em","size":-0.02},"title_color":"#031830","_margin":{"unit":"px","top":"0","right":"0","bottom":"28","left":"0","isLinked":false},"max_width":{"unit":"%","size":80}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"heading","editSettings":{"defaultEditRoute":"content"}},{"id":"3f0e6a73","elType":"widget","isInner":false,"isLocked":false,"settings":{"editor":"<p style=\"font-family: Inter,sans-serif; font-size: 1.05rem; line-height: 1.75; color: rgba(3,24,48,0.6); font-weight: 300; text-align: center; max-width: 560px; margin: 0 auto;\">La adicci\u00f3n siempre ha servido para algo. En Emerae trabajamos para entender qu\u00e9 hay detr\u00e1s \u2014 y darte las herramientas para sostener el cambio.<\/p>","_margin":{"unit":"px","top":"0","right":"0","bottom":"48","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"text-editor","editSettings":{"defaultEditRoute":"content"}},{"id":"1d9d548","elType":"widget","isInner":false,"isLocked":false,"settings":{"editor":"<p><span style=\"font-weight: 400;\">El consumo es una huida de una realidad que duele tanto.\u00a0<\/span><\/p><p><span style=\"font-weight: 400;\">Antes del consumo hubo una historia. Hubo heridas, formas de sobrevivir, emociones que nadie supo sostener.<\/span><\/p><p><span style=\"font-weight: 400;\">Por eso en Emerae no tratamos \u00fanicamente la adicci\u00f3n.<\/span><\/p><p><span style=\"font-weight: 400;\">Trabajamos con la persona que hay detr\u00e1s.<\/span><\/p>","_margin":{"unit":"px","top":"0","right":"0","bottom":"48","left":"0","isLinked":false},"align":"center"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"text-editor","editSettings":{"defaultEditRoute":"content"}},{"id":"42a5048b","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<style>.em-selector{width:100%;max-width:720px;margin:0 auto}.em-selector__level1{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:16px}.em-selector__btn-l1{font-family:Inter,sans-serif;font-size:.82rem;font-weight:500;padding:10px 22px;border-radius:100px;border:1.5px solid rgba(3,24,48,0.25);background:rgba(255,255,255,0.6);color:rgba(3,24,48,0.8);cursor:pointer;transition:all .2s;letter-spacing:.02em;backdrop-filter:blur(8px)}.em-selector__btn-l1:hover{border-color:#045CB4;color:#045CB4}.em-selector__btn-l1.active{background:#045CB4;border-color:#045CB4;color:#fff}.em-selector__level2{display:none;flex-wrap:wrap;gap:10px;justify-content:center;margin-bottom:0}.em-selector__level2.visible{display:flex}.em-selector__btn-l2{font-family:Inter,sans-serif;font-size:.78rem;font-weight:400;padding:8px 18px;border-radius:100px;border:1.5px solid rgba(3,24,48,0.15);background:rgba(255,255,255,0.5);color:rgba(3,24,48,0.7);cursor:pointer;transition:all .2s;backdrop-filter:blur(8px)}.em-selector__btn-l2:hover{border-color:#045CB4;color:#045CB4}.em-selector__btn-l2.active{background:#045CB4;border-color:#045CB4;color:#fff}.em-selector__panel{display:none;margin-top:20px;background:rgba(255,255,255,0.7);backdrop-filter:blur(12px);border:1px solid rgba(3,24,48,0.1);border-radius:16px;padding:24px 28px;font-family:Inter,sans-serif;color:rgba(3,24,48,0.7);font-size:.92rem;line-height:1.7;text-align:left}.em-selector__panel.visible{display:block}.em-selector__panel h4{font-family:'Instrument Serif',serif;font-size:1.1rem;color:#031830;margin-bottom:6px;font-style:italic}<\/style><div class=\"em-selector\"><div class=\"em-selector__level1\"><button class=\"em-selector__btn-l1\" data-group=\"para-mi\" onclick=\"emSelectL1(this)\">Para m\u00ed<\/button><button class=\"em-selector__btn-l1\" data-group=\"para-alguien\" onclick=\"emSelectL1(this)\">Para alguien que quiero<\/button><button class=\"em-selector__btn-l1\" data-group=\"profesional\" onclick=\"emSelectL1(this)\">Soy profesional<\/button><\/div><div class=\"em-selector__level2\" id=\"em-l2-para-mi\"><button class=\"em-selector__btn-l2\" data-panel=\"para-mi-listo\" onclick=\"emSelectL2(this)\">Estoy listo para empezar<\/button><button class=\"em-selector__btn-l2\" data-panel=\"para-mi-nose\" onclick=\"emSelectL2(this)\">No s\u00e9 si lo necesito<\/button><button class=\"em-selector__btn-l2\" data-panel=\"para-mi-como\" onclick=\"emSelectL2(this)\">\u00bfC\u00f3mo es el tratamiento?<\/button><\/div><div class=\"em-selector__level2\" id=\"em-l2-para-alguien\"><button class=\"em-selector__btn-l2\" data-panel=\"alguien-noacep\" onclick=\"emSelectL2(this)\">No acepta ayuda<\/button><button class=\"em-selector__btn-l2\" data-panel=\"alguien-listo\" onclick=\"emSelectL2(this)\">Est\u00e1 listo para pedir ayuda<\/button><button class=\"em-selector__btn-l2\" data-panel=\"alguien-hijo\" onclick=\"emSelectL2(this)\">Es mi hijo\/a<\/button><button class=\"em-selector__btn-l2\" data-panel=\"alguien-como\" onclick=\"emSelectL2(this)\">\u00bfC\u00f3mo es el tratamiento?<\/button><\/div><div class=\"em-selector__level2\" id=\"em-l2-profesional\"><button class=\"em-selector__btn-l2\" data-panel=\"prof-derivar\" onclick=\"emSelectL2(this)\">Derivar un paciente<\/button><button class=\"em-selector__btn-l2\" data-panel=\"prof-enfoque\" onclick=\"emSelectL2(this)\">Conoce nuestro enfoque<\/button><\/div><div class=\"em-selector__panel\" id=\"panel-para-mi-listo\"><h4>El primer paso ya lo has dado<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-para-mi-nose\"><h4>La duda tambi\u00e9n es una se\u00f1al<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-para-mi-como\"><h4>Un proceso hecho a tu medida<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-alguien-noacep\"><h4>Cuando la persona no acepta ayuda<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-alguien-listo\"><h4>Est\u00e1 listo para pedir ayuda<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-alguien-hijo\"><h4>Es mi hijo\/a<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-alguien-como\"><h4>C\u00f3mo es el tratamiento<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-prof-derivar\"><h4>Derivar un paciente<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><div class=\"em-selector__panel\" id=\"panel-prof-enfoque\"><h4>Nuestro enfoque cl\u00ednico<\/h4><p>Contenido por definir en la siguiente fase.<\/p><\/div><\/div><script>function emSelectL1(btn){document.querySelectorAll('.em-selector__btn-l1').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.em-selector__level2').forEach(d=>d.classList.remove('visible'));document.querySelectorAll('.em-selector__panel').forEach(p=>p.classList.remove('visible'));document.querySelectorAll('.em-selector__btn-l2').forEach(b=>b.classList.remove('active'));btn.classList.add('active');var group=btn.getAttribute('data-group');var l2=document.getElementById('em-l2-'+group);if(l2)l2.classList.add('visible')}function emSelectL2(btn){var parent=btn.closest('.em-selector__level2');parent.querySelectorAll('.em-selector__btn-l2').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.em-selector__panel').forEach(p=>p.classList.remove('visible'));btn.classList.add('active');var panelId='panel-'+btn.getAttribute('data-panel');var panel=document.getElementById(panelId);if(panel)panel.classList.add('visible')}<\/script>","_margin":{"unit":"px","top":"0","right":"0","bottom":"60","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}},{"id":"503ed7ca","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<div style=\"display:flex;align-items:center;justify-content:center;gap:32px;flex-wrap:wrap;padding-top:32px;border-top:1px solid rgba(3,24,48,0.1);\"><span style=\"font-family:Inter,sans-serif;font-size:0.78rem;color:rgba(3,24,48,0.5);\">Primera consulta gratuita<\/span><span style=\"color:rgba(3,24,48,0.2);\">\u00b7<\/span><span style=\"font-family:Inter,sans-serif;font-size:0.78rem;color:rgba(3,24,48,0.5);\">Sin compromiso<\/span><span style=\"color:rgba(3,24,48,0.2);\">\u00b7<\/span><span style=\"font-family:Inter,sans-serif;font-size:0.78rem;color:rgba(3,24,48,0.5);\">Atenci&oacute;n inmediata<\/span><\/div>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout","panel":{"activeTab":"layout","activeSection":"section_layout_container"}}}],"page_settings":{"template":"default"},"version":"0.4","title":"1.HERO_EMERAE","type":"container"}