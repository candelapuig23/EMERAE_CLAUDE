0)}50%{transform:translateY(7px)}}\n@keyframes floatD{0%,100%{transform:translateY(0)}50%{transform:translateY(9px)}}\n@media(max-width:768px){.em-cita{display:none;}.em-citas{min-height:auto;padding:60px 20px;}}\n<\/style>\n\n<div class=\"em-citas\">\n  <div class=\"em-cita em-cita--tl\">\n    <span class=\"em-cita__line\"><\/span>\n    <p class=\"em-cita__quote\">&ldquo;Sent&iacute; calma al sentir que hab&iacute;a cura para m&iacute;.&rdquo;<\/p>\n  <\/div>\n  <div class=\"em-cita em-cita--tr\">\n    <span class=\"em-cita__line\"><\/span>\n    <p class=\"em-cita__quote\">&ldquo;Soy m&aacute;s que mi adicci&oacute;n.&rdquo;<\/p>\n  <\/div>\n  <div class=\"em-cita em-cita--bl\">\n    <span class=\"em-cita__line\"><\/span>\n    <p class=\"em-cita__quote\">&ldquo;Necesitaba que alguien me recogiese, que alguien me escuchase.&rdquo;<\/p>\n  <\/div>\n  <div class=\"em-cita em-cita--br\">\n    <span class=\"em-cita__line\"><\/span>\n    <p class=\"em-cita__quote\">&ldquo;Hice tratamiento para aprender a ser capaz de sentir sin consumir.&rdquo;<\/p>\n  <\/div>\n  <div class=\"em-citas__center\">\n    <p class=\"em-citas__text\">Nadie nace queriendo ser adicto. Detr&aacute;s de cada adicci&oacute;n hay una persona con mucho dolor &mdash; y una capacidad de cambio que <em>a veces ni ella misma conoce todav&iacute;a.<\/em><\/p>\n  <\/div>\n<\/div>","_margin":{"unit":"px","top":"0","right":"30","bottom":"0","left":"30","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout","panel":{"activeTab":"layout","activeSection":"section_layout"}}}],"page_settings":{"template":"default"},"version":"0.4","title":"2.2CITAS_EMERAE","type":"section"}