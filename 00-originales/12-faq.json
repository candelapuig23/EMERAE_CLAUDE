 aqu\u00ed, escr\u00edbenos. Estaremos encantados de responderla.<\/p>","typography_typography":"custom","typography_font_family":"Inter","typography_font_size":{"size":0.90000000000000002,"unit":"rem"},"typography_font_weight":"300","typography_line_height":{"size":1.75,"unit":"em"},"text_color":"#4a5a6a","_margin":{"unit":"px","top":"0","right":"0","bottom":"28","left":"0","isLinked":false}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"text-editor","editSettings":{"defaultEditRoute":"content"}},{"id":"4e9882b1","elType":"widget","isInner":false,"isLocked":false,"settings":{"text":"H\u00e1znos una pregunta \u2192","link":{"url":"#","is_external":false},"border_border":"solid","border_width":{"unit":"px","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"border_color":"rgba(3,24,48,0.2)","border_radius":{"unit":"px","top":"100","right":"100","bottom":"100","left":"100","isLinked":true},"typography_typography":"custom","typography_font_family":"Inter","typography_font_size":{"size":0.84999999999999998,"unit":"rem"},"typography_font_weight":"400","button_background_color":"transparent","padding":{"unit":"px","top":"10","right":"22","bottom":"10","left":"22","isLinked":false},"_margin":{"unit":"px","top":"-43","right":"0","bottom":"0","left":"0","isLinked":false},"__globals__":{"background_color":"globals\/colors?id=bfc094f","button_text_color":"globals\/colors?id=065e55b","hover_color":"globals\/colors?id=bfc094f","button_background_hover_color":"globals\/colors?id=065e55b"}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"button","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}},{"id":"1c4fab8c","elType":"container","isInner":true,"isLocked":false,"settings":{"flex_direction":"column","width":{"size":65,"unit":"%"},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[{"id":"76780dc6","elType":"widget","isInner":false,"isLocked":false,"settings":{"html":"<style>\n.faq-right{display:flex;flex-direction:column;gap:10px;}\n.faq-item{background:#ffffff;border-radius:14px;overflow:hidden;border:1px solid rgba(3,24,48,0.06);transition:box-shadow 0.2s;}\n.faq-item.open{box-shadow:0 4px 20px rgba(3,24,48,0.07);}\n.faq-question{display:flex;align-items:center;gap:16px;padding:20px 24px;cursor:pointer;}\n.faq-num{font-size:0.72rem;font-weight:500;color:#BDDAE8;flex-shrink:0;letter-spacing:0.05em;min-width:24px;font-family:Inter,sans-serif;}\n.faq-question-text{font-family:Inter,sans-serif;font-size:0.9rem;font-weight:500;color:#031830;line-height:1.4;flex:1;transition:color 0.2s;}\n.faq-item.open .faq-question-text{color:#045CB4;}\n.faq-chevron{width:26px;height:26px;border-radius:50%;border:1px solid rgba(3,24,48,0.1);background:#f7f8f9;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.25s;color:#7a8a9a;font-size:0.7rem;font-family:sans-serif;}\n.faq-item.open .faq-chevron{background:#045CB4;border-color:#045CB4;color:white;transform:rotate(180deg);}\n.faq-answer{max-height:0;overflow:hidden;transition:max-height 0.35s ease;}\n.faq-item.open .faq-answer{max-height:200px;}\n.faq-answer-inner{padding:0 24px 22px 64px;font-family:Inter,sans-serif;font-size:0.85rem;color:#4a5a6a;line-height:1.75;font-weight:300;}\n<\/style>\n<div class=\"faq-right\">\n  <div class=\"faq-item open\">\n    <div class=\"faq-question\" onclick=\"toggleFaq(this)\">\n      <span class=\"faq-num\">01<\/span>\n      <span class=\"faq-question-text\">\u00bfC\u00f3mo s\u00e9 si lo que tengo es una adicci\u00f3n?<\/span>\n      <span class=\"faq-chevron\">&#9662;<\/span>\n    <\/div>\n    <div class=\"faq-answer\"><p class=\"faq-answer-inner\">No hace falta llegar a un punto de crisis para tener una adicci\u00f3n. Si sientes que una sustancia o conducta ocupa demasiado espacio en tu vida, que intentas reducirla y no puedes, o que empiezas a tener consecuencias en tu trabajo, relaciones o bienestar, es un buen momento para hablar con alguien. La primera consulta en Emerae es gratuita y sin compromiso.<\/p><\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\" onclick=\"toggleFaq(this)\">\n      <span class=\"faq-num\">02<\/span>\n      <span class=\"faq-question-text\">\u00bfEs confidencial el tratamiento?<\/span>\n      <span class=\"faq-chevron\">&#9662;<\/span>\n    <\/div>\n    <div class=\"faq-answer\"><p class=\"faq-answer-inner\">S\u00ed, completamente. Todo lo que se trabaja en Emerae es estrictamente privado. Ning\u00fan dato personal ni cl\u00ednico se comparte con terceros sin tu consentimiento expreso.<\/p><\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\" onclick=\"toggleFaq(this)\">\n      <span class=\"faq-num\">03<\/span>\n      <span class=\"faq-question-text\">\u00bfCu\u00e1nto dura el proceso?<\/span>\n      <span class=\"faq-chevron\">&#9662;<\/span>\n    <\/div>\n    <div class=\"faq-answer\"><p class=\"faq-answer-inner\">Depende de cada persona y de la complejidad de su situaci\u00f3n. No trabajamos con plazos fijos porque cada proceso es diferente. Lo que s\u00ed podemos decirte es que desde la primera sesi\u00f3n trabajamos con objetivos claros y medibles.<\/p><\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\" onclick=\"toggleFaq(this)\">\n      <span class=\"faq-num\">04<\/span>\n      <span class=\"faq-question-text\">\u00bfQu\u00e9 pasa si la persona no quiere pedir ayuda?<\/span>\n      <span class=\"faq-chevron\">&#9662;<\/span>\n    <\/div>\n    <div class=\"faq-answer\"><p class=\"faq-answer-inner\">Es una situaci\u00f3n muy frecuente. En Emerae tambi\u00e9n trabajamos con familias y personas del entorno del paciente. Podemos ayudarte a entender qu\u00e9 est\u00e1 pasando, c\u00f3mo comunicarte sin empeorar la situaci\u00f3n y qu\u00e9 pasos dar mientras la persona no est\u00e9 lista para pedir ayuda.<\/p><\/div>\n  <\/div>\n  <div class=\"faq-item\">\n    <div class=\"faq-question\" onclick=\"toggleFaq(this)\">\n      <span class=\"faq-num\">05<\/span>\n      <span class=\"faq-question-text\">\u00bfTrabaj\u00e1is solo de forma presencial o tambi\u00e9n online?<\/span>\n      <span class=\"faq-chevron\">&#9662;<\/span>\n    <\/div>\n    <div class=\"faq-answer\"><p class=\"faq-answer-inner\">Trabajamos en ambas modalidades. Tenemos consulta presencial en Barcelona y tambi\u00e9n ofrecemos sesi\u00f3n online para quienes no pueden desplazarse o prefieren esta opci\u00f3n. La calidad del acompa\u00f1amiento es la misma en las dos modalidades.<\/p><\/div>\n  <\/div>\n<\/div>\n<script>\nfunction toggleFaq(el){\n  var item=el.parentElement;\n  var isOpen=item.classList.contains('open');\n  document.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open');});\n  if(!isOpen)item.classList.add('open');\n}\n<\/script>"},"defaultEditSettings":{"defaultEditRoute":"content"},"interactions":[],"elements":[],"widgetType":"html","editSettings":{"defaultEditRoute":"content"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout"}}],"editSettings":{"defaultEditRoute":"layout","panel":{"activeTab":"layout","activeSection":"section_layout_container"}}}],"page_settings":{"template":"default"},"version":"0.4","title":"12.FAQS_EMERAE","type":"container"}